# ===================================================================
# Laravel Production Environment Configuration Example
# Salin file ini menjadi .env di server VPS Anda
# ===================================================================

APP_NAME="Sistem Manifest Lisensi Software"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

# Version tag image Docker dari GHCR (opsional, default: latest)
IMAGE_TAG=latest

# Kunci pendaftaran agent dan password user bawaan
AGENT_REGISTRATION_KEY=change-this-to-a-very-secure-random-string
DEFAULT_USER_PASSWORD=change-this-secure-default-password

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE="Asia/Makassar"

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# Database MySQL (Shared instance Dokploy / Host)
DB_CONNECTION=mysql
DB_HOST=shared-mysql-xxxxxx
DB_PORT=3306
DB_DATABASE=db_manifest
DB_USERNAME=manifest_user
DB_PASSWORD=generate_strong_db_password_here

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue & Cache (Shared Redis Dokploy)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=shared-redis-xxxxxx
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=manifest_

# Horizon
HORIZON_PREFIX=manifest_horizon:

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Opsi otomatisasi container startup
AUTORUN_MIGRATIONS=true
AUTORUN_OPTIMIZATIONS=true

VITE_APP_NAME="${APP_NAME}"
